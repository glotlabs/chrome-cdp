# A secret typed into the page, and a step that fails naming it: the
# value must appear in no output or artifact.
@test "types a secret"
  goto /e2e/shop.html
  fill 'label=New todo' ${secret:E2E_TODO_SECRET}
  expect text=${secret:E2E_TODO_SECRET} visible --timeout 300ms

# The page shows the secret, and the test passes: its fingerprints
# (plan 18.2) must not hold the value either.
@test "shows a secret"
  goto /e2e/shop.html
  fill 'label=New todo' ${secret:E2E_TODO_SECRET}
  press Enter
  expect text=${secret:E2E_TODO_SECRET} visible
