  - searchbox "Search orders" [ref]
- complementary "Folders" [ref] scrollable
  - list [ref]
    - listitem
      - clickable "Folder 1" [ref]
      - text "(7)"
    - listitem
      - clickable "Folder 2" [ref]
      - text "(14)"
    - listitem
    - … 30 more listitem (use --scope [ref] --all)
- main
  - heading "Orders" (h1)
  - toolbar "Bulk actions"
    - button "Export" [ref]
    - button "Archive" [ref]
  - table [ref]
    - row
      - columnheader
        - checkbox "Select all" [ref] unchecked
      - columnheader "Order"
      - columnheader "Customer"
      - columnheader "Status"
      - columnheader "Total"
      - columnheader "Actions"
    - row
      - cell
        - checkbox "Select order 1" [ref] unchecked
      - cell
        - link "#1001" [ref] → /orders/1
      - cell "Customer 1"
      - cell "Pending"
      - cell "$13.00"
      - cell
        - button "Edit" [ref]
        - button "Delete order 1" [ref]
    - … 271 more row (use --scope [ref] --all)
- contentinfo "Big app footer"
!Section 31"
!Folder 31"
!Delete order 30"
