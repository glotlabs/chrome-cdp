{
  "$defs": {
    "ActedElement": {
      "description": "An element an action acted on, as the output names it.",
      "properties": {
        "name": {
          "description": "Its accessible name (or text), cut to 60 characters.",
          "type": "string"
        },
        "ref": {
          "description": "Its ref, e.g. `e6` (absent if the page changed before one could\nbe given).",
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "description": "Its role (`generic` for none).",
          "type": "string"
        },
        "tag": {
          "description": "Its tag name, lower case.",
          "type": "string"
        }
      },
      "required": [
        "role",
        "name",
        "tag"
      ],
      "type": "object"
    },
    "Body": {
      "description": "A request's or response's body, fetched from Chrome when asked for.",
      "properties": {
        "binary": {
          "description": "Not text (an image, a font, …): not shown.",
          "type": "boolean"
        },
        "size": {
          "description": "Its size in bytes, when known.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "text": {
          "description": "The body as text (a JSON body pretty-printed only in the text\nform); absent for a binary or unavailable body.",
          "type": [
            "string",
            "null"
          ]
        },
        "unavailable": {
          "description": "Why there is no body to show: Chrome no longer has it, the request\nfailed or is still loading, …",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "DownloadInfo": {
      "description": "A file the browser downloaded (or is downloading) into the session's\n`downloads` directory.",
      "properties": {
        "file": {
          "description": "The file's name, as the server suggested it (made unique in the\ndirectory).",
          "type": "string"
        },
        "path": {
          "description": "The absolute path of the file, once it completed.",
          "type": [
            "string",
            "null"
          ]
        },
        "received_bytes": {
          "description": "Bytes received so far.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "state": {
          "description": "`in_progress`, `completed` or `canceled`.",
          "type": "string"
        },
        "tab": {
          "description": "The tab whose page started it, if known.",
          "type": [
            "string",
            "null"
          ]
        },
        "total_bytes": {
          "description": "The size the server announced, if it did.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "url": {
          "description": "The URL downloaded.",
          "type": "string"
        }
      },
      "required": [
        "url",
        "file",
        "state",
        "received_bytes"
      ],
      "type": "object"
    },
    "ErrEnvelope": {
      "properties": {
        "error": {
          "$ref": "#/$defs/ErrorInfo",
          "description": "What went wrong and what to run next."
        },
        "events": {
          "default": [],
          "description": "Page events observed while the command ran.",
          "items": {
            "$ref": "#/$defs/Event"
          },
          "type": "array"
        },
        "ok": {
          "const": false,
          "description": "Always `false`.",
          "type": "boolean"
        },
        "warnings": {
          "default": [],
          "description": "Non-fatal notes.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "ok",
        "error"
      ],
      "type": "object"
    },
    "ErrorInfo": {
      "description": "A command failure as the user sees it: what happened, and the next\ncommand to run.",
      "properties": {
        "details": {
          "description": "Structured context (candidates, observed URL, CDP error code, …)."
        },
        "hint": {
          "description": "The concrete next command to try.",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/ErrorKind",
          "description": "The stable error name."
        },
        "message": {
          "description": "One line saying what happened.",
          "type": "string"
        },
        "notes": {
          "description": "Short labelled facts shown between the message and the hint in the\ntext form (`covering: div \"We use cookies\" [e88]`).",
          "items": {
            "$ref": "#/$defs/Note"
          },
          "type": "array"
        }
      },
      "required": [
        "kind",
        "message"
      ],
      "type": "object"
    },
    "ErrorKind": {
      "description": "What went wrong, as a stable machine-readable name.\n\nThe name is part of the `--json` contract (`\"kind\":\"Timeout\"`) and each\nkind maps to one process exit code.",
      "oneOf": [
        {
          "const": "NotFound",
          "description": "No element matches the locator.",
          "type": "string"
        },
        {
          "const": "Ambiguous",
          "description": "The locator matches several elements where one is needed.",
          "type": "string"
        },
        {
          "const": "Obscured",
          "description": "Another element covers the target.",
          "type": "string"
        },
        {
          "const": "NotEnabled",
          "description": "The target is disabled.",
          "type": "string"
        },
        {
          "const": "RefStale",
          "description": "The ref is from an older snapshot.",
          "type": "string"
        },
        {
          "const": "RefDetached",
          "description": "The ref's element was removed from the page.",
          "type": "string"
        },
        {
          "const": "ExpectFailed",
          "description": "An `expect` assertion failed.",
          "type": "string"
        },
        {
          "const": "EvalError",
          "description": "JavaScript threw.",
          "type": "string"
        },
        {
          "const": "NavigationFailed",
          "description": "Navigation failed (DNS, TLS, HTTP error page, …).",
          "type": "string"
        },
        {
          "const": "BadArgs",
          "description": "Bad flags or arguments.",
          "type": "string"
        },
        {
          "const": "BadLocator",
          "description": "The locator does not parse.",
          "type": "string"
        },
        {
          "const": "Timeout",
          "description": "Something did not happen in time.",
          "type": "string"
        },
        {
          "const": "ChromeNotFound",
          "description": "No Chrome binary was found.",
          "type": "string"
        },
        {
          "const": "LaunchFailed",
          "description": "Chrome was found but could not be started.",
          "type": "string"
        },
        {
          "const": "BrowserCrashed",
          "description": "Chrome exited or the connection to it dropped.",
          "type": "string"
        },
        {
          "const": "PageCrashed",
          "description": "A tab's page crashed (its renderer process died); `reload` brings\nit back.",
          "type": "string"
        },
        {
          "const": "DaemonUnavailable",
          "description": "The session daemon cannot be reached or started.",
          "type": "string"
        },
        {
          "const": "ProtocolError",
          "description": "Chrome rejected a CDP call.",
          "type": "string"
        },
        {
          "const": "InstallFailed",
          "description": "Downloading or unpacking a browser (`chrome-cdp install`) failed.",
          "type": "string"
        },
        {
          "const": "DialogOpen",
          "description": "A JavaScript dialog blocks the page.",
          "type": "string"
        }
      ]
    },
    "Event": {
      "description": "Something that happened in the browser while a command ran. The\nenvelope lists them in `events`; the command's text says what matters.",
      "oneOf": [
        {
          "description": "A tab opened that no command asked for: a popup (`window.open`,\n`target=_blank`) or one the user opened. It is not active unless the\nsession follows popups (`open --follow-popups`).",
          "properties": {
            "active": {
              "description": "Whether it became the active tab.",
              "type": "boolean"
            },
            "opener": {
              "description": "The tab that opened it, if known.",
              "type": [
                "string",
                "null"
              ]
            },
            "tab": {
              "description": "The new tab's id.",
              "type": "string"
            },
            "type": {
              "const": "tab_opened",
              "type": "string"
            },
            "url": {
              "description": "Its URL when the command ended (it may still be loading).",
              "type": "string"
            }
          },
          "required": [
            "type",
            "tab",
            "url",
            "active"
          ],
          "type": "object"
        },
        {
          "description": "A JavaScript dialog closed without a `chrome-cdp dialog` command:\nthe session's `--dialogs` policy answered it (an `alert` or\n`beforeunload` by default), or a navigation dismissed it.",
          "properties": {
            "accepted": {
              "description": "Whether it was accepted (else dismissed).",
              "type": "boolean"
            },
            "by": {
              "description": "`policy` (the session's `--dialogs` answered it) or `other`\n(it closed without `chrome-cdp dialog`: a navigation dismissed\nit, or a raw CDP call answered it).",
              "type": "string"
            },
            "kind": {
              "description": "`alert`, `confirm`, `prompt` or `beforeunload`.",
              "type": "string"
            },
            "message": {
              "description": "The text it showed.",
              "type": "string"
            },
            "tab": {
              "description": "The tab it opened in.",
              "type": "string"
            },
            "type": {
              "const": "dialog",
              "type": "string"
            }
          },
          "required": [
            "type",
            "tab",
            "kind",
            "message",
            "accepted",
            "by"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/DownloadInfo",
          "description": "A download started, or finished, while the command ran.",
          "properties": {
            "type": {
              "const": "download",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "The action made the tab's main frame navigate (a link, a form, a\nscript): where it is now, once loaded and settled.",
          "properties": {
            "error": {
              "description": "Chrome's error when the page could not load\n(`net::ERR_CONNECTION_REFUSED`; the tab shows an error page).",
              "type": [
                "string",
                "null"
              ]
            },
            "loaded": {
              "description": "Whether the load event fired before the time ran out.",
              "type": "boolean"
            },
            "restored": {
              "description": "It came back from the back/forward cache.",
              "type": "boolean"
            },
            "same_document": {
              "description": "It stayed in the document (`pushState`, `#fragment`).",
              "type": "boolean"
            },
            "status": {
              "description": "The main document's HTTP status (absent for same-document\nnavigations and non-HTTP pages).",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "tab": {
              "description": "The tab, e.g. `t1`.",
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "type": {
              "const": "navigated",
              "type": "string"
            },
            "url": {
              "description": "The URL it is at now.",
              "type": "string"
            }
          },
          "required": [
            "type",
            "tab",
            "url",
            "title",
            "loaded"
          ],
          "type": "object"
        },
        {
          "description": "The page logged an error (`console.error`, a failed\n`console.assert`) or threw one nothing caught, after the command\nbegan.",
          "properties": {
            "column": {
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "line": {
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "message": {
              "description": "The message's first line, e.g. `TypeError: x is undefined`.",
              "type": "string"
            },
            "tab": {
              "description": "The tab, e.g. `t1`.",
              "type": "string"
            },
            "type": {
              "const": "console_error",
              "type": "string"
            },
            "uncaught": {
              "description": "An uncaught exception (else a `console.error` call).",
              "type": "boolean"
            },
            "url": {
              "description": "The script it came from, with its line and column (1-based).",
              "type": [
                "string",
                "null"
              ]
            }
          },
          "required": [
            "type",
            "tab",
            "message",
            "uncaught"
          ],
          "type": "object"
        },
        {
          "description": "A request of the page to its own origin failed after the command\nbegan: an HTTP status of 400 or more, or no response.",
          "properties": {
            "error": {
              "description": "Chrome's error if it did not, e.g. `net::ERR_CONNECTION_REFUSED`.",
              "type": [
                "string",
                "null"
              ]
            },
            "method": {
              "type": "string"
            },
            "resource_type": {
              "description": "Chrome's resource type: `Document`, `Fetch`, `XHR`, `Script`, …",
              "type": "string"
            },
            "status": {
              "description": "The HTTP status, if the server answered.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "tab": {
              "description": "The tab, e.g. `t1`.",
              "type": "string"
            },
            "type": {
              "const": "request_failed",
              "type": "string"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "tab",
            "method",
            "url",
            "resource_type"
          ],
          "type": "object"
        },
        {
          "description": "Focus moved to an element of another form than before (or into a\nform, or out of one) that the action did not act on: a dialog or\nthe next step of a flow took it.",
          "properties": {
            "element": {
              "$ref": "#/$defs/ActedElement"
            },
            "tab": {
              "description": "The tab, e.g. `t1`.",
              "type": "string"
            },
            "type": {
              "const": "focus_moved",
              "type": "string"
            }
          },
          "required": [
            "type",
            "tab",
            "element"
          ],
          "type": "object"
        }
      ]
    },
    "Header": {
      "description": "One HTTP header.",
      "properties": {
        "name": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "value"
      ],
      "type": "object"
    },
    "Initiator": {
      "description": "What sent a request.",
      "properties": {
        "function": {
          "description": "The function that sent it, for a script.",
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "type": {
          "description": "`parser` (the HTML), `script`, `preload`, `preflight`, `other`, …",
          "type": "string"
        },
        "url": {
          "description": "The document or script, with the line (1-based).",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "type"
      ],
      "type": "object"
    },
    "NetworkEntry": {
      "description": "One request of the tab's network log (each redirect hop is its own).",
      "properties": {
        "blocked": {
          "description": "Why Chrome blocked it: `csp`, `mixed-content`, `inspector`, …",
          "type": [
            "string",
            "null"
          ]
        },
        "body_size": {
          "description": "The body's size once decoded.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "cache": {
          "description": "Which cache served it: `memory`, `disk` or `prefetch`.",
          "type": [
            "string",
            "null"
          ]
        },
        "cors": {
          "description": "The CORS check that failed: `MissingAllowOriginHeader`, and the\nvalue at fault if any.",
          "type": [
            "string",
            "null"
          ]
        },
        "duration_ms": {
          "description": "From start to end (or to the redirect); for a WebSocket, how long\nit was open.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "error": {
          "description": "Chrome's error, for a failed request: `net::ERR_CONNECTION_REFUSED`.",
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "description": "Its id in the tab's log (`network show <id>`); later ones are\nlarger (`--since <id>`).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "initiator": {
          "anyOf": [
            {
              "$ref": "#/$defs/Initiator"
            },
            {
              "type": "null"
            }
          ],
          "description": "What sent it."
        },
        "method": {
          "type": "string"
        },
        "mime": {
          "description": "The response's MIME type.",
          "type": [
            "string",
            "null"
          ]
        },
        "protocol": {
          "description": "`http/1.1`, `h2`, `h3`, …",
          "type": [
            "string",
            "null"
          ]
        },
        "redirect": {
          "description": "Where a redirect sent it (the next hop is the next request with\nthis URL).",
          "type": [
            "string",
            "null"
          ]
        },
        "service_worker": {
          "description": "A service worker answered it.",
          "type": "boolean"
        },
        "size": {
          "description": "Bytes received over the network, headers included (0 from a\ncache); for a WebSocket, the frames' payloads.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "state": {
          "$ref": "#/$defs/RequestState"
        },
        "status": {
          "description": "The HTTP status, once a response came.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "status_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "time_ms": {
          "description": "When the daemon saw it start, in ms since the Unix epoch.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "type": {
          "description": "Chrome's resource type in lower case: `document`, `xhr`, `fetch`,\n`script`, `stylesheet`, `image`, `websocket`, …",
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "websocket": {
          "anyOf": [
            {
              "$ref": "#/$defs/WebSocketSummary"
            },
            {
              "type": "null"
            }
          ],
          "description": "A WebSocket's traffic."
        }
      },
      "required": [
        "id",
        "time_ms",
        "method",
        "url",
        "type",
        "state"
      ],
      "type": "object"
    },
    "NetworkShowData": {
      "description": "`data` of `chrome-cdp network show --json`.",
      "properties": {
        "frames": {
          "description": "A WebSocket's last frames (at most 20), oldest first.",
          "items": {
            "$ref": "#/$defs/WebSocketFrame"
          },
          "type": "array"
        },
        "request": {
          "$ref": "#/$defs/NetworkEntry"
        },
        "request_body": {
          "anyOf": [
            {
              "$ref": "#/$defs/Body"
            },
            {
              "type": "null"
            }
          ],
          "description": "With `--request-body`."
        },
        "request_headers": {
          "description": "With `--headers` (else only counted in the text form).",
          "items": {
            "$ref": "#/$defs/Header"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "response_body": {
          "anyOf": [
            {
              "$ref": "#/$defs/Body"
            },
            {
              "type": "null"
            }
          ],
          "description": "With `--body`."
        },
        "response_headers": {
          "items": {
            "$ref": "#/$defs/Header"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "tab": {
          "description": "The tab, e.g. `t1`.",
          "type": "string"
        },
        "timing": {
          "anyOf": [
            {
              "$ref": "#/$defs/Timing"
            },
            {
              "type": "null"
            }
          ],
          "description": "Where the time went, from Chrome's resource timing (absent from a\ncache)."
        }
      },
      "required": [
        "tab",
        "request"
      ],
      "type": "object"
    },
    "Note": {
      "description": "One labelled line of an error's text form.",
      "properties": {
        "label": {
          "description": "A short lowercase label, e.g. `covering`.",
          "type": "string"
        },
        "text": {
          "description": "One line of text.",
          "type": "string"
        }
      },
      "required": [
        "label",
        "text"
      ],
      "type": "object"
    },
    "OkEnvelope": {
      "properties": {
        "data": {
          "$ref": "#/$defs/NetworkShowData",
          "description": "The command's result."
        },
        "events": {
          "default": [],
          "description": "Page events observed while the command ran (tabs opened, dialogs,\nnavigations, …).",
          "items": {
            "$ref": "#/$defs/Event"
          },
          "type": "array"
        },
        "ok": {
          "const": true,
          "description": "Always `true`.",
          "type": "boolean"
        },
        "truncated": {
          "default": [],
          "description": "Values in `data` shortened to keep the output bounded; `--max-chars`\n(or the command's own flag, named in the warning) shows more.",
          "items": {
            "$ref": "#/$defs/Truncation"
          },
          "type": "array"
        },
        "warnings": {
          "default": [],
          "description": "Non-fatal notes.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "ok",
        "data"
      ],
      "type": "object"
    },
    "RequestState": {
      "description": "Where a request is.",
      "oneOf": [
        {
          "const": "pending",
          "description": "Sent, not finished yet (a WebSocket: still open).",
          "type": "string"
        },
        {
          "const": "done",
          "description": "Finished with a response (whatever its status), or redirected.",
          "type": "string"
        },
        {
          "const": "failed",
          "description": "Ended without a response: `error` says why.",
          "type": "string"
        },
        {
          "const": "canceled",
          "description": "Canceled by the page or a navigation.",
          "type": "string"
        }
      ]
    },
    "Timing": {
      "description": "A request's phases, in ms.",
      "properties": {
        "blocked_ms": {
          "description": "Waiting before the request could go (queueing, proxy, …).",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "connect_ms": {
          "description": "Opening the connection, TLS included.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "dns_ms": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "receive_ms": {
