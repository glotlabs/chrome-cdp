{
  "$defs": {
    "ErrEnvelope": {
      "properties": {
        "error": {
          "$ref": "#/$defs/ErrorInfo",
          "description": "What went wrong and what to run next."
        },
        "events": {
          "default": [],
          "description": "Page events observed while the command ran.",
          "items": {
            "$ref": "#/$defs/Event"
          },
          "type": "array"
        },
        "ok": {
          "const": false,
          "description": "Always `false`.",
          "type": "boolean"
        },
        "warnings": {
          "default": [],
          "description": "Non-fatal notes.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "ok",
        "error"
      ],
      "type": "object"
    },
    "ErrorInfo": {
      "description": "A command failure as the user sees it: what happened, and the next\ncommand to run.",
      "properties": {
        "details": {
          "description": "Structured context (candidates, observed URL, CDP error code, …)."
        },
        "hint": {
          "description": "The concrete next command to try.",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/ErrorKind",
          "description": "The stable error name."
        },
        "message": {
          "description": "One line saying what happened.",
          "type": "string"
        },
        "notes": {
          "description": "Short labelled facts shown between the message and the hint in the\ntext form (`covering: div \"We use cookies\" [e88]`).",
          "items": {
            "$ref": "#/$defs/Note"
          },
          "type": "array"
        }
      },
      "required": [
        "kind",
        "message"
      ],
      "type": "object"
    },
    "ErrorKind": {
      "description": "What went wrong, as a stable machine-readable name.\n\nThe name is part of the `--json` contract (`\"kind\":\"Timeout\"`) and each\nkind maps to one process exit code.",
      "oneOf": [
        {
          "const": "NotFound",
          "description": "No element matches the locator.",
          "type": "string"
        },
        {
          "const": "Ambiguous",
          "description": "The locator matches several elements where one is needed.",
          "type": "string"
        },
        {
          "const": "Obscured",
          "description": "Another element covers the target.",
          "type": "string"
        },
        {
          "const": "NotEnabled",
          "description": "The target is disabled.",
          "type": "string"
        },
        {
          "const": "RefStale",
          "description": "The ref is from an older snapshot.",
          "type": "string"
        },
        {
          "const": "RefDetached",
          "description": "The ref's element was removed from the page.",
          "type": "string"
        },
        {
          "const": "ExpectFailed",
          "description": "An `expect` assertion failed.",
          "type": "string"
        },
        {
          "const": "EvalError",
          "description": "JavaScript threw.",
          "type": "string"
        },
        {
          "const": "NavigationFailed",
          "description": "Navigation failed (DNS, TLS, HTTP error page, …).",
          "type": "string"
        },
        {
          "const": "BadArgs",
          "description": "Bad flags or arguments.",
          "type": "string"
        },
        {
          "const": "BadLocator",
          "description": "The locator does not parse.",
          "type": "string"
        },
        {
          "const": "Timeout",
          "description": "Something did not happen in time.",
          "type": "string"
        },
        {
          "const": "ChromeNotFound",
          "description": "No Chrome binary was found.",
          "type": "string"
        },
        {
          "const": "LaunchFailed",
          "description": "Chrome was found but could not be started.",
          "type": "string"
        },
        {
          "const": "BrowserCrashed",
          "description": "Chrome exited or the connection to it dropped.",
          "type": "string"
        },
        {
          "const": "DaemonUnavailable",
          "description": "The session daemon cannot be reached or started.",
          "type": "string"
        },
        {
          "const": "ProtocolError",
          "description": "Chrome rejected a CDP call.",
          "type": "string"
        },
        {
          "const": "InstallFailed",
          "description": "Downloading or unpacking a browser (`chrome-cdp install`) failed.",
          "type": "string"
        },
        {
          "const": "DialogOpen",
          "description": "A JavaScript dialog blocks the page.",
          "type": "string"
        }
      ]
    },
    "Event": {
      "description": "Something that happened in the browser while a command ran. The\nenvelope lists them in `events`; the command's text says what matters.",
      "oneOf": [
        {
          "description": "A tab opened that no command asked for: a popup (`window.open`,\n`target=_blank`) or one the user opened. It is not active unless the\nsession follows popups (`open --follow-popups`).",
          "properties": {
            "active": {
              "description": "Whether it became the active tab.",
              "type": "boolean"
            },
            "opener": {
              "description": "The tab that opened it, if known.",
              "type": [
                "string",
                "null"
              ]
            },
            "tab": {
              "description": "The new tab's id.",
              "type": "string"
            },
            "type": {
              "const": "tab_opened",
              "type": "string"
            },
            "url": {
              "description": "Its URL when the command ended (it may still be loading).",
              "type": "string"
            }
          },
          "required": [
            "type",
            "tab",
            "url",
            "active"
          ],
          "type": "object"
        }
      ]
    },
    "Note": {
      "description": "One labelled line of an error's text form.",
      "properties": {
        "label": {
          "description": "A short lowercase label, e.g. `covering`.",
          "type": "string"
        },
        "text": {
          "description": "One line of text.",
          "type": "string"
        }
      },
      "required": [
        "label",
        "text"
      ],
      "type": "object"
    },
    "OkEnvelope": {
      "properties": {
        "data": {
          "$ref": "#/$defs/WaitData",
          "description": "The command's result."
        },
        "events": {
          "default": [],
          "description": "Page events observed while the command ran (tabs opened, dialogs,\nnavigations, …).",
          "items": {
            "$ref": "#/$defs/Event"
          },
          "type": "array"
        },
        "ok": {
          "const": true,
          "description": "Always `true`.",
          "type": "boolean"
        },
        "truncated": {
          "default": [],
          "description": "Values in `data` shortened to keep the output bounded; `--max-chars`\n(or the command's own flag, named in the warning) shows more.",
          "items": {
            "$ref": "#/$defs/Truncation"
          },
          "type": "array"
        },
        "warnings": {
          "default": [],
          "description": "Non-fatal notes.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "ok",
        "data"
      ],
      "type": "object"
    },
    "RequestInfo": {
      "description": "A request or response a wait matched.",
      "properties": {
        "method": {
          "description": "`GET`, `POST`, … (empty if not known).",
          "type": "string"
        },
        "status": {
          "description": "The HTTP status, for a response.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "method",
        "url"
      ],
      "type": "object"
    },
    "TruncatedKind": {
      "description": "What kind of value was shortened.",
      "oneOf": [
        {
          "const": "string",
          "description": "Lengths count characters.",
          "type": "string"
        },
        {
          "const": "array",
          "description": "Lengths count items.",
          "type": "string"
        }
      ]
    },
    "Truncation": {
      "description": "One value that `--json` output shortened to fit the budget.",
      "properties": {
        "kept": {
          "description": "How much was kept (a cut string also ends in `…`).",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/TruncatedKind",
          "description": "A string (lengths in characters) or an array (lengths in items)."
        },
        "len": {
          "description": "The original length.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "description": "Where, as a JSON Pointer into `data` (`/result/value`).",
          "type": "string"
        }
      },
      "required": [
        "path",
        "kind",
        "len",
        "kept"
      ],
      "type": "object"
    },
    "WaitData": {
      "description": "`data` of `chrome-cdp wait --json`.",
      "properties": {
        "condition": {
          "description": "What was waited for: `load`, `domcontentloaded`, `idle`, `settle`,\n`element`, `text`, `text_gone`, `url`, `fn`, `request`, `response`\nor `delay`.",
          "type": "string"
        },
        "count": {
          "description": "`wait <locator>`: how many elements matched.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "elapsed_ms": {
          "description": "Milliseconds the wait took.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "met": {
          "description": "What held, in words: `text \"Welcome\" is visible`.",
          "type": "string"
        },
        "request": {
          "anyOf": [
            {
              "$ref": "#/$defs/RequestInfo"
            },
            {
              "type": "null"
            }
          ],
          "description": "`--request` and `--response`: the one that matched."
        },
        "tab": {
          "description": "The tab watched, e.g. `t1`.",
          "type": "string"
        },
        "url": {
          "description": "The main frame's URL when it held.",
          "type": "string"
        },
        "value": {
          "description": "`--fn`: the expression's value (as JSON; other values as a string)."
        }
      },
      "required": [
        "tab",
        "condition",
        "met",
        "url",
        "elapsed_ms"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/OkEnvelope",
      "description": "The command succeeded."
    },
    {
      "$ref": "#/$defs/ErrEnvelope",
      "description": "The command failed."
    }
  ],
  "description": "The `--json` envelope (see [`crate::Envelope`]) with `data: T`.",
  "title": "chrome-cdp wait --json"
}
