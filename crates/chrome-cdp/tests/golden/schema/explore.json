{
  "$defs": {
    "ActedElement": {
      "description": "An element an action acted on, as the output names it.",
      "properties": {
        "name": {
          "description": "Its accessible name (or text), cut to 60 characters.",
          "type": "string"
        },
        "ref": {
          "description": "Its ref, e.g. `e6` (absent if the page changed before one could\nbe given).",
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "description": "Its role (`generic` for none).",
          "type": "string"
        },
        "tag": {
          "description": "Its tag name, lower case.",
          "type": "string"
        }
      },
      "required": [
        "role",
        "name",
        "tag"
      ],
      "type": "object"
    },
    "DownloadInfo": {
      "description": "A file the browser downloaded (or is downloading) into the session's\n`downloads` directory.",
      "properties": {
        "file": {
          "description": "The file's name, as the server suggested it (made unique in the\ndirectory).",
          "type": "string"
        },
        "path": {
          "description": "The absolute path of the file, once it completed.",
          "type": [
            "string",
            "null"
          ]
        },
        "received_bytes": {
          "description": "Bytes received so far.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "state": {
          "description": "`in_progress`, `completed` or `canceled`.",
          "type": "string"
        },
        "tab": {
          "description": "The tab whose page started it, if known.",
          "type": [
            "string",
            "null"
          ]
        },
        "total_bytes": {
          "description": "The size the server announced, if it did.",
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "url": {
          "description": "The URL downloaded.",
          "type": "string"
        }
      },
      "required": [
        "url",
        "file",
        "state",
        "received_bytes"
      ],
      "type": "object"
    },
    "ErrEnvelope": {
      "properties": {
        "error": {
          "$ref": "#/$defs/ErrorInfo",
          "description": "What went wrong and what to run next."
        },
        "events": {
          "default": [],
          "description": "Page events observed while the command ran.",
          "items": {
            "$ref": "#/$defs/Event"
          },
          "type": "array"
        },
        "ok": {
          "const": false,
          "description": "Always `false`.",
          "type": "boolean"
        },
        "warnings": {
          "default": [],
          "description": "Non-fatal notes.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "ok",
        "error"
      ],
      "type": "object"
    },
    "ErrorInfo": {
      "description": "A command failure as the user sees it: what happened, and the next\ncommand to run.",
      "properties": {
        "details": {
          "description": "Structured context (candidates, observed URL, CDP error code, …)."
        },
        "hint": {
          "description": "The concrete next command to try.",
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/ErrorKind",
          "description": "The stable error name."
        },
        "message": {
          "description": "One line saying what happened.",
          "type": "string"
        },
        "notes": {
          "description": "Short labelled facts shown between the message and the hint in the\ntext form (`covering: div \"We use cookies\" [e88]`).",
          "items": {
            "$ref": "#/$defs/Note"
          },
          "type": "array"
        }
      },
      "required": [
        "kind",
        "message"
      ],
      "type": "object"
    },
    "ErrorKind": {
      "description": "What went wrong, as a stable machine-readable name.\n\nThe name is part of the `--json` contract (`\"kind\":\"Timeout\"`) and each\nkind maps to one process exit code.",
      "oneOf": [
        {
          "const": "NotFound",
          "description": "No element matches the locator.",
          "type": "string"
        },
        {
          "const": "Ambiguous",
          "description": "The locator matches several elements where one is needed.",
          "type": "string"
        },
        {
          "const": "Obscured",
          "description": "Another element covers the target.",
          "type": "string"
        },
        {
          "const": "NotEnabled",
          "description": "The target is disabled.",
          "type": "string"
        },
        {
          "const": "RefStale",
          "description": "The ref is from an older snapshot.",
          "type": "string"
        },
        {
          "const": "RefDetached",
          "description": "The ref's element was removed from the page.",
          "type": "string"
        },
        {
          "const": "ExpectFailed",
          "description": "An `expect` assertion failed.",
          "type": "string"
        },
        {
          "const": "EvalError",
          "description": "JavaScript threw.",
          "type": "string"
        },
        {
          "const": "NavigationFailed",
          "description": "Navigation failed (DNS, TLS, HTTP error page, …).",
          "type": "string"
        },
        {
          "const": "NoSource",
          "description": "Nothing in the page says where an element came from (`source`, `components`).",
          "type": "string"
        },
        {
          "const": "HotUpdateFailed",
          "description": "A dev server's hot update failed (`wait --hmr`): the page still\nruns the old code.",
          "type": "string"
        },
        {
          "const": "BadArgs",
          "description": "Bad flags or arguments.",
          "type": "string"
        },
        {
          "const": "BadLocator",
          "description": "The locator does not parse.",
          "type": "string"
        },
        {
          "const": "Timeout",
          "description": "Something did not happen in time.",
          "type": "string"
        },
        {
          "const": "ChromeNotFound",
          "description": "No Chrome binary was found.",
          "type": "string"
        },
        {
          "const": "LaunchFailed",
          "description": "Chrome was found but could not be started.",
          "type": "string"
        },
        {
          "const": "BrowserCrashed",
          "description": "Chrome exited or the connection to it dropped.",
          "type": "string"
        },
        {
          "const": "PageCrashed",
          "description": "A tab's page crashed (its renderer process died); `reload` brings\nit back.",
          "type": "string"
        },
        {
          "const": "DaemonUnavailable",
          "description": "The session daemon cannot be reached or started.",
          "type": "string"
        },
        {
          "const": "ProtocolError",
          "description": "Chrome rejected a CDP call.",
          "type": "string"
        },
        {
          "const": "InstallFailed",
          "description": "Downloading or unpacking a browser (`chrome-cdp install`) or a\nrelease (`chrome-cdp upgrade`) failed.",
          "type": "string"
        },
        {
          "const": "DialogOpen",
          "description": "A JavaScript dialog blocks the page.",
          "type": "string"
        }
      ]
    },
    "Event": {
      "description": "Something that happened in the browser while a command ran. The\nenvelope lists them in `events`; the command's text says what matters.",
      "oneOf": [
        {
          "description": "A tab opened that no command asked for: a popup (`window.open`,\n`target=_blank`) or one the user opened. It is not active unless the\nsession follows popups (`open --follow-popups`).",
          "properties": {
            "active": {
              "description": "Whether it became the active tab.",
              "type": "boolean"
            },
            "opener": {
              "description": "The tab that opened it, if known.",
              "type": [
                "string",
                "null"
              ]
            },
            "tab": {
              "description": "The new tab's id.",
              "type": "string"
            },
            "type": {
              "const": "tab_opened",
              "type": "string"
            },
            "url": {
              "description": "Its URL when the command ended (it may still be loading).",
              "type": "string"
            }
          },
          "required": [
            "type",
            "tab",
            "url",
            "active"
          ],
          "type": "object"
        },
        {
          "description": "A JavaScript dialog closed without a `chrome-cdp dialog` command:\nthe session's `--dialogs` policy answered it (an `alert` or\n`beforeunload` by default), or a navigation dismissed it.",
          "properties": {
            "accepted": {
              "description": "Whether it was accepted (else dismissed).",
              "type": "boolean"
            },
            "by": {
              "description": "`policy` (the session's `--dialogs` answered it) or `other`\n(it closed without `chrome-cdp dialog`: a navigation dismissed\nit, or a raw CDP call answered it).",
              "type": "string"
            },
            "kind": {
              "description": "`alert`, `confirm`, `prompt` or `beforeunload`.",
              "type": "string"
            },
            "message": {
              "description": "The text it showed.",
              "type": "string"
            },
            "tab": {
              "description": "The tab it opened in.",
              "type": "string"
            },
            "type": {
              "const": "dialog",
              "type": "string"
            }
          },
          "required": [
            "type",
            "tab",
            "kind",
            "message",
            "accepted",
            "by"
          ],
          "type": "object"
        },
        {
          "$ref": "#/$defs/DownloadInfo",
          "description": "A download started, or finished, while the command ran.",
          "properties": {
            "type": {
              "const": "download",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        },
        {
          "description": "The action made the tab's main frame navigate (a link, a form, a\nscript): where it is now, once loaded and settled.",
          "properties": {
            "error": {
              "description": "Chrome's error when the page could not load\n(`net::ERR_CONNECTION_REFUSED`; the tab shows an error page).",
              "type": [
                "string",
                "null"
              ]
            },
            "loaded": {
              "description": "Whether the load event fired before the time ran out.",
              "type": "boolean"
            },
            "restored": {
              "description": "It came back from the back/forward cache.",
              "type": "boolean"
            },
            "same_document": {
              "description": "It stayed in the document (`pushState`, `#fragment`).",
              "type": "boolean"
            },
            "status": {
              "description": "The main document's HTTP status (absent for same-document\nnavigations and non-HTTP pages).",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "tab": {
              "description": "The tab, e.g. `t1`.",
              "type": "string"
            },
            "title": {
              "type": "string"
            },
            "type": {
              "const": "navigated",
              "type": "string"
            },
            "url": {
              "description": "The URL it is at now.",
              "type": "string"
            }
          },
          "required": [
            "type",
            "tab",
            "url",
            "title",
            "loaded"
          ],
          "type": "object"
        },
        {
          "description": "The page logged an error (`console.error`, a failed\n`console.assert`) or threw one nothing caught, after the command\nbegan.",
          "properties": {
            "column": {
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "line": {
              "format": "uint32",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "message": {
              "description": "The message's first line, e.g. `TypeError: x is undefined`.",
              "type": "string"
            },
            "original": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SourcePosition"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Where it came from in the original source, when a source map\nsays so (localhost pages), with the file on disk if found."
            },
            "tab": {
              "description": "The tab, e.g. `t1`.",
              "type": "string"
            },
            "type": {
              "const": "console_error",
              "type": "string"
            },
            "uncaught": {
              "description": "An uncaught exception (else a `console.error` call).",
              "type": "boolean"
            },
            "url": {
              "description": "The script it came from, with its line and column (1-based).",
              "type": [
                "string",
                "null"
              ]
            },
            "worker": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Worker"
                },
                {
                  "type": "null"
                }
              ],
              "description": "The worker it came from, if a worker's."
            }
          },
          "required": [
            "type",
            "tab",
            "message",
            "uncaught"
          ],
          "type": "object"
        },
        {
          "description": "A request of the page to its own origin failed after the command\nbegan: an HTTP status of 400 or more, or no response.",
          "properties": {
            "error": {
              "description": "Chrome's error if it did not, e.g. `net::ERR_CONNECTION_REFUSED`.",
              "type": [
                "string",
                "null"
              ]
            },
            "id": {
              "description": "Its id in the tab's network log (`network show <id>`), if the\nlog has it.",
              "format": "uint64",
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "method": {
              "type": "string"
            },
            "resource_type": {
              "description": "Chrome's resource type: `Document`, `Fetch`, `XHR`, `Script`, …",
              "type": "string"
            },
            "status": {
              "description": "The HTTP status, if the server answered.",
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0,
              "type": [
                "integer",
                "null"
              ]
            },
            "tab": {
              "description": "The tab, e.g. `t1`.",
              "type": "string"
            },
            "type": {
              "const": "request_failed",
              "type": "string"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "tab",
            "method",
            "url",
            "resource_type"
          ],
          "type": "object"
        },
        {
          "description": "A logpoint (`chrome-cdp debug log`) was hit after the command\nbegan.",
          "properties": {
            "file": {
              "description": "The source on disk (an absolute path), when found.",
              "type": [
                "string",
                "null"
              ]
            },
            "id": {
              "description": "The logpoint's id (`debug list`, `debug clear <id>`).",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "line": {
              "description": "The original line it is bound at (1-based).",
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "place": {
              "description": "Its place as text shows it: the file relative to the project root\nwhen chrome-cdp found it, else the source's URL path, with the\nline it is bound at (`src/cart.ts:42`).",
              "type": "string"
            },
            "tab": {
              "description": "The tab, e.g. `t1`.",
              "type": "string"
            },
            "type": {
              "const": "logpoint",
              "type": "string"
            },
            "values": {
              "description": "Each expression's value, in the order given.",
              "items": {
                "$ref": "#/$defs/LogpointValue"
              },
              "type": "array"
            }
          },
          "required": [
            "type",
            "tab",
            "id",
            "place",
            "line",
            "values"
          ],
          "type": "object"
        },
        {
          "description": "A dev server's hot update reached the tab: while an action ran,\nor (on any command on the tab) since the tab's previous command.\nEach is reported once.",
          "properties": {
            "client": {
              "description": "The dev server's client in the page: `vite`, `webpack`\n(webpack-dev-server) or `next` (Next.js).",
              "type": "string"
            },
            "files": {
              "description": "`applied`: the files updated; `full_reload`: the file that asked\nfor it. Left out when the dev server does not say.",
              "items": {
                "$ref": "#/$defs/HotFile"
              },
              "type": "array"
            },
            "message": {
              "description": "`failed`: the error's first line, as the dev server gave it.",
              "type": [
                "string",
                "null"
              ]
            },
            "outcome": {
              "$ref": "#/$defs/HotOutcome"
            },
            "place": {
              "anyOf": [
                {
                  "$ref": "#/$defs/SourcePosition"
                },
                {
                  "type": "null"
                }
              ],
              "description": "`failed`: where, when the error says (`source` as the dev server\nnames it)."
            },
            "tab": {
              "description": "The tab, e.g. `t1`.",
              "type": "string"
            },
            "type": {
              "const": "hot_update",
              "type": "string"
            }
          },
          "required": [
            "type",
            "tab",
            "client",
            "outcome"
          ],
          "type": "object"
        },
        {
          "description": "Focus moved to an element of another form than before (or into a\nform, or out of one, or into another frame) that the action did not\nact on: a dialog or the next step of a flow took it.",
          "properties": {
            "element": {
              "$ref": "#/$defs/ActedElement"
            },
            "frame": {
              "description": "The frame it is in, when that is not the tab's main frame: the\nframe's id (what `--frame` takes; `frames` lists them).",
              "type": [
                "string",
                "null"
              ]
            },
            "tab": {
              "description": "The tab, e.g. `t1`.",
              "type": "string"
            },
            "type": {
              "const": "focus_moved",
              "type": "string"
            }
          },
          "required": [
            "type",
            "tab",
            "element"
          ],
          "type": "object"
        }
      ]
    },
    "ExploreBroken": {
      "description": "A step that led to an error page or no page.",
      "properties": {
        "error": {
          "description": "Chrome's error when there was no answer.",
          "type": [
            "string",
            "null"
          ]
        },
        "from": {
          "description": "The state it was taken in.",
          "type": "string"
        },
        "status": {
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "step": {
          "$ref": "#/$defs/ExploreStep"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "from",
        "step",
        "url"
      ],
      "type": "object"
    },
    "ExploreBudget": {
      "description": "The limits of an `explore` walk.",
      "properties": {
        "depth": {
          "description": "The most steps from the start.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "max_actions": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "max_states": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "time_ms": {
          "description": "In milliseconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "max_states",
        "max_actions",
        "depth",
        "time_ms"
      ],
      "type": "object"
    },
    "ExploreData": {
      "description": "`data` of `chrome-cdp explore --json` (and `map.json` of `explore\n-o`).",
      "properties": {
        "actions": {
          "description": "The clicks and loads made, replayed ones included.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "broken": {
          "description": "Links and clicks that led to an error page or no page.",
          "items": {
            "$ref": "#/$defs/ExploreBroken"
          },
          "type": "array"
        },
        "budget": {
          "$ref": "#/$defs/ExploreBudget"
        },
        "dir": {
          "description": "`-o`: the directory written, absolute.",
          "type": [
            "string",
            "null"
          ]
        },
        "duration_ms": {
          "description": "How long the walk took, in milliseconds.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "edges": {
          "description": "Each step that led from one state to another; the first to reach\na state is its path's last step.",
          "items": {
            "$ref": "#/$defs/ExploreEdge"
          },
          "type": "array"
        },
        "failed": {
          "description": "Steps that failed (the element could not be clicked), or states\nthe walk could not get back to.",
          "items": {
            "$ref": "#/$defs/ExploreFailed"
          },
          "type": "array"
        },
        "problems": {
          "description": "How many problems were found: console errors, failed requests,\nbroken links and (with `--layout`) layout errors, over all\nstates. `--exit-code` exits 1 when it is not 0.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "skipped": {
          "$ref": "#/$defs/ExploreSkipped",
          "description": "What the walk did not follow on purpose."
        },
        "start": {
          "description": "The URL the walk started at, as loaded.",
          "type": "string"
        },
        "states": {
          "description": "The states found, in the order found (`s1` is the start).",
          "items": {
            "$ref": "#/$defs/ExploreState"
          },
          "type": "array"
        },
        "stopped_by": {
          "description": "What ended the walk: `done` (everything allowed was followed),\n`depth` (all followed but what `--depth` left), `max-states`,\n`max-actions` or `time`.",
          "type": "string"
        },
        "unvisited": {
          "description": "What the budget left unvisited.",
          "items": {
            "$ref": "#/$defs/ExploreLeft"
          },
          "type": "array"
        }
      },
      "required": [
        "start",
        "stopped_by",
        "budget",
        "actions",
        "duration_ms",
        "states",
        "edges",
        "broken",
        "skipped",
        "problems"
      ],
      "type": "object"
    },
    "ExploreEdge": {
      "description": "A step from one state to another.",
      "properties": {
        "from": {
          "type": "string"
        },
        "step": {
          "$ref": "#/$defs/ExploreStep"
        },
        "to": {
          "type": "string"
        }
      },
      "required": [
        "from",
        "to",
        "step"
      ],
      "type": "object"
    },
    "ExploreElement": {
      "description": "What a step clicked, as the snapshot names it.",
      "properties": {
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        }
      },
      "required": [
        "role",
        "name",
        "tag"
      ],
      "type": "object"
    },
    "ExploreFailed": {
      "description": "A step that failed, or a state the walk could not get back to.",
      "properties": {
        "error": {
          "type": "string"
        },
        "from": {
          "type": "string"
        },
        "step": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExploreStep"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "from",
        "error"
      ],
      "type": "object"
    },
    "ExploreLeft": {
      "description": "A step the budget left.",
      "properties": {
        "from": {
          "type": "string"
        },
        "step": {
          "$ref": "#/$defs/ExploreStep"
        }
      },
      "required": [
        "from",
        "step"
      ],
      "type": "object"
    },
    "ExploreSkip": {
      "description": "One thing not followed.",
      "properties": {
        "element": {
          "$ref": "#/$defs/ExploreElement"
        },
        "from": {
          "description": "The state it is in.",
          "type": "string"
        },
        "url": {
          "description": "A link's target.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "from",
        "element"
      ],
      "type": "object"
    },
    "ExploreSkipped": {
      "description": "What the walk did not follow, by why.",
      "properties": {
        "destructive": {
          "description": "Controls whose name looks destructive (`--allow-destructive`).",
          "items": {
            "$ref": "#/$defs/ExploreSkip"
          },
          "type": "array"
        },
        "external": {
          "description": "Links to other origins (`--origin` allows one), and links\n`--include` or `--exclude` rule out.",
          "items": {
            "$ref": "#/$defs/ExploreSkip"
          },
          "type": "array"
        },
        "files": {
          "description": "Links to files and downloads.",
          "items": {
            "$ref": "#/$defs/ExploreSkip"
          },
          "type": "array"
        },
        "forms": {
          "description": "Buttons that submit a form (`--submit-forms`).",
          "items": {
            "$ref": "#/$defs/ExploreSkip"
          },
          "type": "array"
        },
        "other": {
          "default": [],
          "description": "`mailto:`, `tel:` and `javascript:` links.",
          "items": {
            "$ref": "#/$defs/ExploreSkip"
          },
          "type": "array"
        }
      },
      "required": [
        "external",
        "destructive",
        "forms",
        "files"
      ],
      "type": "object"
    },
    "ExploreState": {
      "description": "A state of the app: a URL (normalised) and the page's skeleton.",
      "properties": {
        "depth": {
          "description": "Steps from the start.",
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        },
        "dialogs": {
          "description": "The names of the dialogs open in it (a modal is a state of its\nown).",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "errors": {
          "description": "Console errors and uncaught exceptions logged while in it\n(`console_error` events).",
          "items": {
            "$ref": "#/$defs/Event"
          },
          "type": "array"
        },
        "failed_requests": {
          "description": "Requests to an allowed origin that failed while in it\n(`request_failed` events).",
          "items": {
            "$ref": "#/$defs/Event"
          },
          "type": "array"
        },
        "id": {
          "description": "`s1`, `s2`, … in the order found.",
          "type": "string"
        },
        "layout": {
          "description": "`--layout`: the error findings of `layout` at the viewport.",
          "items": {
            "$ref": "#/$defs/LayoutFinding"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "path": {
          "description": "How to get there from the start (after loading it).",
          "items": {
            "$ref": "#/$defs/ExploreStep"
          },
          "type": "array"
        },
        "scenario": {
          "description": "`-o`: its scenario, `states/<id>.cdp`, absolute.",
          "type": [
            "string",
            "null"
          ]
        },
        "screenshot": {
          "description": "`-o --screenshots`: `states/<id>.png`, absolute.",
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "description": "The HTTP status of its document, when known.",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "title": {
          "type": "string"
        },
        "url": {
          "description": "The URL it was found at.",
          "type": "string"
        }
      },
      "required": [
        "id",
        "url",
        "title",
        "depth",
        "path",
        "errors",
        "failed_requests"
      ],
      "type": "object"
    },
    "ExploreStep": {
      "description": "One step of a walk: a click, or a load (of a URL a click opened in a\nnew tab).",
      "properties": {
        "action": {
          "description": "`click` or `goto`.",
          "type": "string"
        },
        "element": {
          "anyOf": [
            {
              "$ref": "#/$defs/ExploreElement"
            },
            {
              "type": "null"
            }
          ],
          "description": "`click`: what was clicked."
        },
        "locator": {
          "description": "`click`: the stable locator of what was clicked.",
          "type": [
            "string",
            "null"
          ]
        },
        "new_tab": {
          "description": "`goto`: a click opened the URL in a new tab (closed again), and the\nwalk loaded it instead.",
          "type": "boolean"
        },
        "url": {
          "description": "`goto`: the URL loaded; a link: its target.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "action"
      ],
      "type": "object"
    },
    "HotFile": {
      "description": "A file a hot update names.",
      "properties": {
        "file": {
          "description": "The file on disk (an absolute path), when chrome-cdp found it\nunder the project root. Text output shows it relative to the root.",
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "description": "As the dev server names it: `/src/cart.ts` (Vite),\n`./src/cart.ts` (webpack).",
          "type": "string"
        }
      },
      "required": [
        "source"
      ],
      "type": "object"
    },
    "HotOutcome": {
      "description": "How a hot update ended.",
      "oneOf": [
        {
          "const": "applied",
          "description": "The page runs the new code.",
          "type": "string"
        },
        {
          "const": "failed",
          "description": "The dev server could not build it (a syntax error), or the page\ncould not run it: the page still runs the old code.",
          "type": "string"
        },
        {
          "const": "full_reload",
          "description": "The dev server reloaded the page.",
          "type": "string"
        }
      ]
    },
    "LayoutBox": {
      "description": "A box in CSS pixels.",
      "properties": {
        "height": {
          "format": "int64",
          "type": "integer"
        },
        "width": {
          "format": "int64",
          "type": "integer"
        },
        "x": {
          "format": "int64",
          "type": "integer"
        },
        "y": {
          "format": "int64",
          "type": "integer"
        }
      },
      "required": [
        "x",
        "y",
        "width",
        "height"
      ],
      "type": "object"
    },
    "LayoutFinding": {
      "description": "One thing that looks broken.",
      "properties": {
        "box": {
          "$ref": "#/$defs/LayoutBox",
          "description": "Its box in CSS pixels of the page (the main document, scroll\nincluded; an iframe's elements moved into it)."
        },
        "details": {
          "additionalProperties": true,
          "description": "Per kind: the covering element, the shown and full sizes, the\ncontrast ratio and colours, …",
          "type": "object"
        },
        "element": {
          "$ref": "#/$defs/WhyElement",
          "description": "The element the finding is about."
        },
        "frame": {
          "description": "The iframe it is in, when not the main frame: its frame id.",
          "type": [
            "string",
            "null"
          ]
        },
        "key": {
          "description": "What `expect --layout` baselines hold: `<kind> <viewport> <stable\nlocator>` (`covered` and `overlap` add the other element's).",
          "type": "string"
        },
        "kind": {
          "description": "`covered`, `overlap`, `clipped`, `truncated`, `overflow-x`,\n`offscreen`, `small-target` or `contrast`.",
          "type": "string"
        },
        "message": {
          "description": "The line of the text output, after the kind.",
          "type": "string"
        },
        "severity": {
          "$ref": "#/$defs/LayoutSeverity"
        },
        "stretched": {
          "description": "Found only with the text stretched (`--stretch-text`).",
          "type": "boolean"
        }
      },
      "required": [
        "kind",
        "severity",
        "key",
        "message",
        "element",
        "box",
        "details"
      ],
      "type": "object"
    },
    "LayoutSeverity": {
      "description": "How much a finding counts: errors are shown by default and fail\n`expect --layout`; info is shown with `--all`.",
      "enum": [
        "error",
        "info"
      ],
      "type": "string"
    },
    "LogpointValue": {
      "description": "An expression of a logpoint, and its value at a hit.",
      "properties": {
        "error": {
          "description": "What it threw (`ReferenceError: total is not defined`).",
          "type": [
            "string",
            "null"
          ]
        },
        "expr": {
          "description": "The expression, as given.",
          "type": "string"
        },
        "value": {
          "description": "Its value, previewed in the page: at most 2 levels deep, strings\ncut at 80 characters, collections over 5 entries counted\n(`[12 items]`), functions as `ƒ`. Absent if it threw.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "expr"
      ],
      "type": "object"
    },
    "Note": {
      "description": "One labelled line of an error's text form.",
      "properties": {
        "label": {
          "description": "A short lowercase label, e.g. `covering`.",
          "type": "string"
        },
        "text": {
          "description": "One line of text, or several for a block such as a diff (the\ntext form prints them indented under the label).",
          "type": "string"
        }
      },
      "required": [
        "label",
        "text"
      ],
      "type": "object"
    },
    "OkEnvelope": {
      "properties": {
        "data": {
          "$ref": "#/$defs/ExploreData",
          "description": "The command's result."
        },
        "events": {
          "default": [],
          "description": "Page events observed while the command ran (tabs opened, dialogs,\nnavigations, …).",
          "items": {
            "$ref": "#/$defs/Event"
          },
          "type": "array"
        },
        "ok": {
          "const": true,
          "description": "Always `true`.",
          "type": "boolean"
        },
        "truncated": {
          "default": [],
          "description": "Values in `data` shortened to keep the output bounded; `--max-chars`\n(or the command's own flag, named in the warning) shows more.",
          "items": {
            "$ref": "#/$defs/Truncation"
          },
          "type": "array"
        },
        "warnings": {
          "default": [],
          "description": "Non-fatal notes.",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "ok",
        "data"
      ],
      "type": "object"
    },
    "SourcePosition": {
      "description": "A place in an original source file, from a source map.",
      "properties": {
        "column": {
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "file": {
          "description": "The source on disk (an absolute path), when chrome-cdp found it:\n`source` as a path, or its path's longest end that is a file under\nthe project root (the directory of `chrome-cdp.toml`, `.git`, …,\nor `source_root` in the config). Text output shows it relative to\nthe root.",
          "type": [
            "string",
            "null"
          ]
        },
        "line": {
          "description": "1-based.",
          "format": "uint32",
          "minimum": 0,
          "type": "integer"
        },
        "name": {
          "description": "The original name at that place, if the map has one.",
          "type": [
            "string",
            "null"
          ]
        },
        "source": {
          "description": "The source file as the map names it, resolved against the map's\nURL (`http://localhost:5173/src/app.ts`) unless it has its own\nscheme (`webpack://app/./src/app.ts`).",
          "type": "string"
        }
      },
      "required": [
        "source",
        "line",
        "column"
      ],
      "type": "object"
    },
    "TruncatedKind": {
      "description": "What kind of value was shortened.",
      "oneOf": [
        {
          "const": "string",
          "description": "Lengths count characters.",
          "type": "string"
        },
        {
          "const": "array",
          "description": "Lengths count items.",
          "type": "string"
        }
      ]
    },
    "Truncation": {
      "description": "One value that `--json` output shortened to fit the budget.",
      "properties": {
        "kept": {
          "description": "How much was kept (a cut string also ends in `…`).",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "kind": {
          "$ref": "#/$defs/TruncatedKind",
          "description": "A string (lengths in characters) or an array (lengths in items)."
        },
        "len": {
          "description": "The original length.",
          "format": "uint",
          "minimum": 0,
          "type": "integer"
        },
        "path": {
          "description": "Where, as a JSON Pointer into `data` (`/result/value`).",
          "type": "string"
        }
      },
      "required": [
        "path",
        "kind",
        "len",
        "kept"
      ],
      "type": "object"
    },
    "WhyElement": {
      "description": "An element `why` names: the one it checked, or one that causes a\nfailed check (the covering banner, the disabled fieldset).",
      "properties": {
        "class": {
          "description": "Its first class, which names an element without a role\n(`div.cookie-banner`).",
          "type": "string"
        },
        "name": {
          "description": "Its accessible name (or text), cut to 60 characters.",
          "type": "string"
        },
        "ref": {
          "description": "Its ref, e.g. `e6` (absent if the page changed before one could\nbe given).",
          "type": [
            "string",
            "null"
          ]
        },
        "role": {
          "description": "Its role (`generic` for none).",
          "type": "string"
        },
        "tag": {
          "description": "Its tag name, lower case.",
          "type": "string"
        }
      },
      "required": [
        "role",
        "name",
        "tag"
      ],
      "type": "object"
    },
    "Worker": {
      "description": "A worker, as an entry of a tab's log names it.",
      "properties": {
        "kind": {
          "$ref": "#/$defs/WorkerKind"
        },
        "url": {
          "description": "Its script.",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "url"
      ],
      "type": "object"
    },
    "WorkerKind": {
      "description": "What kind of worker.",
      "oneOf": [
        {
          "const": "dedicated",
          "description": "A page's or iframe's own `Worker`, of one tab.",
          "type": "string"
        },
        {
          "const": "shared",
          "description": "A `SharedWorker`: of every tab of its origin.",
          "type": "string"
        },
        {
          "const": "service",
          "description": "A service worker: of every tab of its origin.",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "anyOf": [
    {
      "$ref": "#/$defs/OkEnvelope",
      "description": "The command succeeded."
    },
    {
      "$ref": "#/$defs/ErrEnvelope",
      "description": "The command failed."
    }
  ],
  "description": "The `--json` envelope (see [`crate::Envelope`]) with `data: T`.",
  "title": "chrome-cdp explore --json"
}
